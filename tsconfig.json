{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "dist", "rootDir": ".", "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "verbatimModuleSyntax": true, "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true, "noPropertyAccessFromIndexSignature": true,
    "declaration": true, "declarationMap": true, "sourceMap": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
